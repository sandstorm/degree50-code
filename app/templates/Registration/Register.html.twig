{% extends 'BaseNoHeader.html.twig' %}
{% trans_default_domain 'UserRegistration' %}

{% block layoutCssClass %}main--with-footer{% endblock %}
{% block title %}{{ "common.degree"|trans({}, 'DegreeBase') }} - {{ "registration.title"|trans({}, 'DegreeBase') }}{% endblock %}

{% block body %}
    <img class="registration-form__background-image" src="{{ asset('build/images/background.png') }}" alt="" />
    <div class="container container--logo">
        <a href="{{ path('app') }}">
            <img src="{{ asset('build/images/logo.svg') }}" alt="{{ "common.logoAltText"|trans({}, 'DegreeBase') }}" />
        </a>
    </div>
    <div class="container container--form">
        <div class="registration-form">
            <h1 class="h2 mb-3 login-form__headline">{{ "common.videoLearningPlatform"|trans({}, 'DegreeBase') }} {{ "common.degree"|trans({}, 'DegreeBase') }}</h1>

            <hr role="presentation"/>

            <h2 class="registration-form__headline">{{ "form.title"|trans }}</h2>
            {{ form_start(registrationForm) }}
                {{ form_row(registrationForm.email) }}
                {{ form_row(registrationForm.plainPassword) }}

                <button type="submit" class="button button--type-primary button--block">{{ "form.submit"|trans }}</button>
            {{ form_end(registrationForm) }}
        </div>
    </div>

    {{ include('Partials/Footer.html.twig', {
        isPrimary: false
    })}}
{% endblock %}
